# LLM Provider API Keys
# Expected variables for LLM APIs. Only the variables relevant to the selected provider need to be used later.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GLM_API_KEY=your_glm_api_key_here

# Search API Key
# To use Google Search, you must provide a Serper API Key (get a free one at https://serper.dev/)
SERPER_API_KEY=your_serper_api_key_here

# Email Credentials
# Supported EMAIL_METHOD options: "smtp" (default), "brevo", or "resend".
EMAIL_METHOD=brevo

# --- 1. For SMTP ---
EMAIL_ADDRESS=your_email_address_here
EMAIL_PASSWORD=your_email_password_here
# Optional: Override these if you are using a custom SMTP provider (defaults to Gmail)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# --- 2. For Brevo API ---
BREVO_API_KEY=your_brevo_api_key_here

# For Resend API:
RESEND_API_KEY=your_resend_api_key_here

# Recipient Email (if overriding config.py)
NOTIFY_EMAIL=your_recipient_email_here
